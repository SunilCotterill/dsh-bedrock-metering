{
  "name": "dsh-bedrock-metering",
  "version": "0.1.0",
  "description": "Meters DeepSeek Harness model calls at Amazon Bedrock on-demand prices, warns near a daily budget, and stops the agent once it is exceeded",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SunilCotterill/dsh-bedrock-metering.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/budget-pill.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./prices/bedrock.json": "./prices/bedrock.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "client/*.js",
    "prices/*.json",
    "scripts/*",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && node --test \"test/**/*.test.ts\"",
    "refresh-prices": "node scripts/refresh-prices"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/dsh-commands": ">=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
